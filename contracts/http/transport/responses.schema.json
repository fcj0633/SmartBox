{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartbox.invalid/contracts/http/transport/responses.schema.json",
  "$defs": {
    "CreateRequest": {
      "type": "object",
      "required": ["box_id"],
      "properties": {
        "box_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,48}$"}
      },
      "additionalProperties": false
    },
    "ItemRequest": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 50},
        "description": {"anyOf": [{"type": "string", "maxLength": 200}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "StartRequest": {
      "type": "object",
      "required": ["confirm_risk"],
      "properties": {
        "confirm_risk": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "TransportTask": {
      "type": "object",
      "required": ["task_id", "transport_no", "box_id", "status", "item_name", "item_description", "started_at", "ended_at", "created_at", "updated_at"],
      "properties": {
        "task_id": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "transport_no": {"type": "string", "pattern": "^TR-[0-9A-F]{20}$"},
        "box_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,48}$"},
        "status": {"enum": ["READY", "ACTIVE", "COMPLETED"]},
        "item_name": {"anyOf": [{"type": "string", "minLength": 1, "maxLength": 50}, {"type": "null"}]},
        "item_description": {"anyOf": [{"type": "string", "maxLength": 200}, {"type": "null"}]},
        "started_at": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "ended_at": {"anyOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]},
        "created_at": {"type": "integer", "minimum": 0},
        "updated_at": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "TransportResponse": {
      "type": "object",
      "required": ["data", "request_id"],
      "properties": {
        "data": {"$ref": "#/$defs/TransportTask"},
        "request_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "TransportListResponse": {
      "type": "object",
      "required": ["data", "request_id"],
      "properties": {
        "data": {"type": "array", "items": {"$ref": "#/$defs/TransportTask"}},
        "request_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["error", "request_id"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "request_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
