{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartbox.invalid/contracts/http/assets/responses.schema.json",
  "$defs": {
    "AssignRequest": {
      "type": "object",
      "required": [
        "rider_user_id"
      ],
      "properties": {
        "rider_user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "additionalProperties": false
    },
    "EnterpriseBox": {
      "type": "object",
      "required": [
        "box_id",
        "display_name",
        "rider_user_id",
        "rider_username",
        "assigned_at"
      ],
      "properties": {
        "box_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "rider_user_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "rider_username": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "assigned_at": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "EnterpriseResponse": {
      "type": "object",
      "required": [
        "data",
        "request_id"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "enterprise_id",
            "enterprise_name",
            "boxes"
          ],
          "properties": {
            "enterprise_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "enterprise_name": {
              "type": "string",
              "minLength": 1
            },
            "boxes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EnterpriseBox"
              }
            }
          },
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "RiderBox": {
      "type": "object",
      "required": [
        "box_id",
        "display_name",
        "source",
        "enterprise_name"
      ],
      "properties": {
        "box_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,48}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "OWNED",
            "ASSIGNED"
          ]
        },
        "enterprise_name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "RiderResponse": {
      "type": "object",
      "required": [
        "data",
        "request_id"
      ],
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RiderBox"
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "AssignmentResponse": {
      "type": "object",
      "required": [
        "data",
        "request_id"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "box_id",
            "rider_user_id",
            "assigned_at"
          ],
          "properties": {
            "box_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$"
            },
            "rider_user_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "assigned_at": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "UnassignResponse": {
      "type": "object",
      "required": [
        "data",
        "request_id"
      ],
      "properties": {
        "data": {
          "type": "object",
          "required": [
            "box_id",
            "assigned"
          ],
          "properties": {
            "box_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,48}$"
            },
            "assigned": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error",
        "request_id"
      ],
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
