# Local demo only. Do not commit real credentials.
SPRING_PROFILES_ACTIVE=dev
SMARTBOX_DB_URL=jdbc:mysql://127.0.0.1:3306/smartbox?connectionTimeZone=UTC&characterEncoding=UTF-8
SMARTBOX_DB_USER=smartbox_app
SMARTBOX_DB_PASSWORD=replace-me
SMARTBOX_MIGRATION_URL=jdbc:mysql://127.0.0.1:3306/smartbox?connectionTimeZone=UTC&characterEncoding=UTF-8
SMARTBOX_MIGRATION_USER=smartbox_app
SMARTBOX_MIGRATION_PASSWORD=replace-me
SMARTBOX_JWT_SECRET_BASE64=REPLACE_WITH_BASE64_32_BYTES
SMARTBOX_MQTT_ENABLED=false
# Only needed when SMARTBOX_MQTT_ENABLED=true
SMARTBOX_MQTT_PROFILE=local
SMARTBOX_MQTT_URL=tcp://127.0.0.1:1883
SMARTBOX_MQTT_USER=smartbox_backend
SMARTBOX_MQTT_PASSWORD=replace-me
SMARTBOX_MQTT_CA_FILE=
SMARTBOX_BOOTSTRAP_FILE=deploy/demo/bootstrap.example.json
SMARTBOX_ASSET_SEED_FILE=deploy/demo/enterprise-v2.seed.example.json
