# SmartBox fixed local demo configuration reference.
# The application does NOT auto-load this file; defaults are in:
#   backend/src/main/resources/application-dev.yml
#   deploy/demo/mqtt.cloud.json
# These values are public demo credentials committed intentionally. Do not use in production.
SPRING_PROFILES_ACTIVE=dev
SMARTBOX_DB_URL=jdbc:mysql://127.0.0.1:3306/smartbox_dev?connectionTimeZone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
SMARTBOX_DB_USER=smartbox_app
SMARTBOX_DB_PASSWORD=CHANGE_APP_PASSWORD
SMARTBOX_MIGRATION_URL=jdbc:mysql://127.0.0.1:3306/smartbox_dev?connectionTimeZone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useSSL=false
SMARTBOX_MIGRATION_USER=smartbox_migrator
SMARTBOX_MIGRATION_PASSWORD=CHANGE_MIGRATION_PASSWORD
SMARTBOX_JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_RANDOM_32_BYTES

# MQTT is auto-configured from deploy/demo/mqtt.cloud.json.
# The fixed remote broker is the only supported broker. No local 1883 fallback.
# Set false only for a temporary simulation-only run.
# SMARTBOX_MQTT_ENABLED=false
# SMARTBOX_MQTT_CLIENT_ID=smartbox_backend
#
# Fixed broker fields (configuration file, not environment):
# URL      ssl://z789ffe0.ala.cn-hangzhou.emqxsl.cn:8883
# USER     smartbox_backend
# PASSWORD committed in deploy/demo/mqtt.cloud.json
# CA       deploy/demo/emqxsl-ca.crt

SMARTBOX_BOOTSTRAP_FILE=deploy/demo/bootstrap.example.json
SMARTBOX_ASSET_SEED_FILE=deploy/demo/enterprise-v2.seed.example.json
