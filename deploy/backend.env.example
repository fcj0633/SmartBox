# SmartBox local demo: placeholder values only. This file is NOT auto-loaded by Spring Boot or PowerShell.
# LocalSettings.java enforces dev => smartbox_dev, app user smartbox_app, Flyway user smartbox_migrator.
SPRING_PROFILES_ACTIVE=dev
SMARTBOX_DB_URL=jdbc:mysql://127.0.0.1:3306/smartbox_dev?connectionTimeZone=UTC&characterEncoding=UTF-8
SMARTBOX_DB_USER=smartbox_app
SMARTBOX_DB_PASSWORD=CHANGE_APP_PASSWORD
SMARTBOX_MIGRATION_URL=jdbc:mysql://127.0.0.1:3306/smartbox_dev?connectionTimeZone=UTC&characterEncoding=UTF-8
SMARTBOX_MIGRATION_USER=smartbox_migrator
SMARTBOX_MIGRATION_PASSWORD=CHANGE_MIGRATION_PASSWORD
SMARTBOX_JWT_SECRET_BASE64=REPLACE_WITH_BASE64_OF_RANDOM_32_BYTES
SMARTBOX_MQTT_ENABLED=false
# For real devices only: remote TLS Broker (do not commit secrets or certificates)
# SMARTBOX_MQTT_URL=ssl://your-authorized-broker.example.com:8883
# SMARTBOX_MQTT_USER=smartbox_backend
# SMARTBOX_MQTT_PASSWORD=SET_LOCALLY
# SMARTBOX_MQTT_CA_FILE=C:/path/to/approved-ca.pem
# Use absolute paths when launching from another working directory.
SMARTBOX_BOOTSTRAP_FILE=deploy/demo/bootstrap.example.json
SMARTBOX_ASSET_SEED_FILE=deploy/demo/enterprise-v2.seed.example.json
